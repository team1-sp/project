# Normalize text files to LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.zip binary

# Append-only logs: a local merge keeps both sides' new entries instead of stopping on a
# conflict (DEC-148.1). Files edited in place (current-status, open-questions) are
# left out on purpose. GitHub's web conflict view ignores this; tools/check_ids.py catches a
# line kept twice. The decision and problem indexes take union too: parallel PRs append rows at
# the same place (DEC-152.1).
docs/agents/state/handoff-log.md merge=union
docs/history/decision-log.md merge=union
docs/history/problems/*.md merge=union
docs/history/decision-index.md merge=union
docs/history/questions-archive.md merge=union
